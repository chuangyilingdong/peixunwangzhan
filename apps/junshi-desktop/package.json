{
  "name": "@junshi/desktop",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "main": "src/main.mjs",
  "description": "招生军师内容工作台独立桌面客户端",
  "scripts": {
    "dev": "electron .",
    "start": "electron .",
    "dist:win": "electron-builder --win nsis",
    "dist:win:signed": "electron-builder --win nsis -c.win.forceCodeSigning=true",
    "dist:dir": "electron-builder --dir",
    "test:unit": "node scripts/test-douyin-data.mjs",
    "test:smoke": "node scripts/smoke.mjs",
    "test:collector": "node scripts/smoke-collector.mjs",
    "test:app": "node scripts/smoke-app.mjs",
    "test:app-ux": "node scripts/smoke-app-ux.mjs",
    "test": "npm run test:unit && npm run test:smoke && npm run test:collector && npm run test:app && npm run test:app-ux"
  },
  "dependencies": {
    "electron-updater": "^6.6.2"
  },
  "devDependencies": {
    "electron": "45.0.0",
    "electron-builder": "26.18.0",
    "playwright-core": "^1.62.1"
  },
  "build": {
    "appId": "com.aicyld.junshi",
    "productName": "招生军师",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "publish": [
      {
        "provider": "generic",
        "url": "https://aicyld.com/downloads/junshi-desktop/"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "artifactName": "招生军师-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "招生军师",
      "deleteAppDataOnUninstall": false
    }
  },
  "author": "灵动ai",
  "homepage": "https://aicyld.com/junshi/"
}




