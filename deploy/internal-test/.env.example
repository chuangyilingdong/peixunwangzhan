# 内部测试环境变量模板（不含任何真实密钥）
# 复制为服务器受控配置文件后再按实际内测地址修改；不要提交复制后的文件。

NODE_ENV=production
DEPLOYMENT_MODE=internal-test
PORT=8788

# 必须指向内测独立数据目录，不能指向仓库中的默认 platform.db
PLATFORM_DATA_DIR=/srv/ai-kids-platform/internal-test/data
PLATFORM_DB_PATH=/srv/ai-kids-platform/internal-test/data/platform.db

# 内测地址仅作示例；正式公开域名、HTTPS、备案不在本阶段配置
PUBLIC_SITE_URL=https://iicili.cyou
ADMIN_APP_ORIGIN=https://iicili.cyou/admin
STUDENT_APP_ORIGIN=https://iicili.cyou/student
ORG_APP_ORIGIN=https://iicili.cyou/org
CORS_ALLOWED_ORIGINS=https://iicili.cyou,https://iicili.cyou/admin,https://iicili.cyou/org,https://iicili.cyou/student

# Vite 构建期变量：必须在执行前端 build 的 shell 中设置，运行时 EnvironmentFile 不会改变已构建 JS
VITE_DEPLOYMENT_MODE=internal-test
VITE_API_BASE=/api
VITE_PUBLIC_SITE_URL=https://iicili.cyou
VITE_ORG_APP_URL=https://iicili.cyou/org

# 真实 adapter 已支持 openai-compatible / custom 的 TEXT；未配置前内测继续使用 local-mock
AI_PROVIDER=local-mock
AI_PROVIDER_MODEL=canvas-mock-v1
AI_PROVIDER_ENDPOINT=
AI_PROVIDER_TIMEOUT_MS=120000
# 真实 AI provider（仅在确认供应商、预算和数据出境政策后启用）
# 密钥只能写入服务器受限 EnvironmentFile 或 Secret 管理器；禁止写入 Git、前端、请求参数或日志。
# AI_PROVIDER=openai-compatible
# AI_PROVIDER_MODEL=
# AI_PROVIDER_ENDPOINT=
# AI_PROVIDER_API_KEY=
