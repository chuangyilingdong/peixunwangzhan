# 内部测试 Nginx 示例
# 这是模板，不是可直接用于公网生产的配置。把 server_name 替换为内部 DNS / hosts 中的地址，
# 并在网络层或 Nginx auth_basic / allow-deny 中落实访问控制后再启用。

# API：只允许内测前端所在的受控来源；8787 仍只监听回环地址
server {
    listen 80;
    server_name api.internal-test.example;

    add_header X-Robots-Tag "noindex, nofollow, noarchive" always;
    auth_basic "Internal test only";
    auth_basic_user_file /etc/nginx/.htpasswd-ai-kids-test;

    location /api/ {
        proxy_pass http://127.0.0.1:8787;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
    location = /health {
        proxy_pass http://127.0.0.1:8787/health;
    }
}

# 每个前端使用独立内测主机名，避免把四个 dist 目录错误拼到同一路径。
server {
    listen 80;
    server_name internal-test.example;
    root /srv/ai-kids-platform/internal-test/current/apps/website;
    index index.html;
    add_header X-Robots-Tag "noindex, nofollow, noarchive" always;
    add_header X-Internal-Test "true" always;
    auth_basic "Internal test only";
    auth_basic_user_file /etc/nginx/.htpasswd-ai-kids-test;
    location /api/ { proxy_pass http://127.0.0.1:8787; }
    location / { try_files $uri $uri/ /index.html; }
}

