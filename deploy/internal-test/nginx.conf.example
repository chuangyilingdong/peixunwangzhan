# AI 少儿编程平台｜iicili.cyou 内部测试单域名配置示例
# 仅用于团队内测：需先在服务器创建 htpasswd，并确认 HTTPS 证书 / 访问控制已就绪。
# 不读取、不迁移、不写入旧站真实数据库；新 API 使用独立内测 SQLite。

server {
    listen 80;
    server_name iicili.cyou;

    add_header X-Robots-Tag "noindex, nofollow, noarchive" always;
    add_header X-Internal-Test "true" always;
    auth_basic "Internal test only";
    auth_basic_user_file /etc/nginx/.htpasswd-ai-kids-test;

    server_tokens off;
    client_max_body_size 2m;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    add_header Content-Security-Policy "default-src 'self'; base-uri 'self'; frame-ancestors 'none'; object-src 'none'; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self'" always;

    # 新内测 API 使用 8788，避免与旧 learning-platform 8787 冲突。
    location = /api { return 301 /api/; }
    # 健康检查在应用根路径 /health；为外部运维保留稳定的 /api/health 入口。
    location = /api/health {
        proxy_pass http://127.0.0.1:8788/health;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
    location /api/ {
        proxy_pass http://127.0.0.1:8788;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /admin { return 301 /admin/; }
    location /admin/ {
        root /srv/ai-kids-platform/internal-test/current/apps;
        try_files $uri $uri/ /admin/index.html;
    }

    location = /org { return 301 /org/; }
    location /org/ {
        root /srv/ai-kids-platform/internal-test/current/apps;
        try_files $uri $uri/ /org/index.html;
    }

    location = /student { return 301 /student/; }
    location /student/ {
        root /srv/ai-kids-platform/internal-test/current/apps;
        try_files $uri $uri/ /student/index.html;
    }

    location / {
        root /srv/ai-kids-platform/internal-test/current/apps/website;
        index index.html;
        try_files $uri $uri/ /index.html;
    }
}
