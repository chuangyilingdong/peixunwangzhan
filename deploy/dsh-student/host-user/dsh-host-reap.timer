[Unit]
Description=每 5 分钟回收闲置的学生创作环境

[Timer]
# 每 5 分钟一次。**用 OnCalendar 而不是 OnUnitActiveSec**：后者是相对「服务上次激活」算的，
# 对 oneshot 服务出现过 NEXT 为空（排不出下一次）的情况（2026-09-16 实测）。
# 开机后先等 10 分钟再开始扫，避免刚开机就把还没预热的环境当成闲置。
OnCalendar=*:0/5
OnBootSec=10min
Persistent=true
Unit=dsh-host-reap.service

[Install]
WantedBy=timers.target
