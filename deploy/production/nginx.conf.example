# AI 少儿编程平台｜iicili.cyou 生产单域名配置
# 生产 API 仅监听 127.0.0.1:8789；80 强制跳转 HTTPS。

server {
    listen 80;
    listen [::]:80;
    server_name iicili.cyou;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name iicili.cyou;

    ssl_certificate /etc/letsencrypt/live/iicili.cyou/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/iicili.cyou/privkey.pem;

    server_tokens off;
    client_max_body_size 26m;

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    # ⚠️ img-src 与 media-src 都必须带 blob:：学生拖进画布的本地素材是「带 token 取回二进制 →
    # blob: 地址」再给 <img>/<video> 用的，CSP 少一个 blob: 就会静默变成破图
    # （2026-09-11 线上踩过：img-src 漏了 blob:，fetch 明明 200、图片就是不显示）。
    add_header Content-Security-Policy "default-src 'self'; base-uri 'self'; frame-ancestors 'none'; object-src 'none'; img-src 'self' data: blob: https:; media-src 'self' data: blob: https:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self'" always;

    # Common scanner targets must not fall back to SPA HTML with HTTP 200.
    # Exact and prefix locations win before the SPA regex fallback behavior used by try_files.
    location = /.env { return 404; }
    location ^~ /.env { return 404; }
    location ^~ /.git { return 404; }
    location ^~ /.aws { return 404; }
    location ^~ /.ssh { return 404; }
    location ^~ /.svn { return 404; }
    location = /.DS_Store { return 404; }
    location = /config.json { return 404; }
    location = /backup.sql { return 404; }
    location = /dump.sql { return 404; }
    location = /wp-login.php { return 404; }
    location = /xmlrpc.php { return 404; }
    location ^~ /phpmyadmin { return 404; }
    location ^~ /actuator { return 404; }

    # Never expose repository, source, dependency, or runtime files through SPA fallback.
    location = /server.js { return 404; }
    location = /package.json { return 404; }
    location = /pnpm-lock.yaml { return 404; }
    location = /pnpm-workspace.yaml { return 404; }
    location ^~ /apps/ { return 404; }
    location ^~ /packages/ { return 404; }
    location ^~ /node_modules/ { return 404; }
    location ^~ /scripts/ { return 404; }
    location ^~ /deploy/ { return 404; }

    location = /api { return 301 /api/; }
    location = /api/health {
        proxy_pass http://127.0.0.1:8789/health;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
    # 上传由 API 进行授权、扫描和流式下载；上传目录不在 Web root 内，不配置静态 location。
    location /api/ {
        proxy_pass http://127.0.0.1:8789;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # 开创作环境（VibeCoding）是**同步等**宿主把学生环境起起来：平台侧超时 90s，
    # 宿主脚本自己还会等 dsh 打印 token（最长 ~60s）。而 location /api/ 没写 proxy_read_timeout
    # ＝ nginx 默认 **60s** —— 也就是「慢一点的学生会先被 nginx 掐成 504」，前端拿到 504 显示
    # 「服务暂时不可用，请稍后重试」，学生会以为系统坏了（2026-09-16 发现）。
    # 这里单独给这条路径放宽；正则 location 优先级高于前缀 /api/。
    location ~ ^/api/student/runtime/(launch|stop)$ {
        proxy_pass http://127.0.0.1:8789;
        proxy_http_version 1.1;
        proxy_read_timeout 180s;
        proxy_send_timeout 180s;
        proxy_buffering off;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # 在线预览类响应允许**同源**内嵌（2026-09-16 修复）。
    # 课件预览（/api/org/file-assets/:id/preview）与学生作品里的 PPT/PDF
    # （/api/{org,student,public}/…/files/:name/preview）都是**在我们自己的页面里用 iframe 打开的**，
    # 而站点级安全头是 X-Frame-Options: DENY + frame-ancestors 'none' → 浏览器一律拒收，
    # 用户看到的是「iicili.cyou 拒绝了我们的连接请求」（实测如此）。
    # 这里只对「以 /preview 结尾」的路径放开到 SAMEORIGIN，别的地方维持 DENY。
    # ⚠️ nginx 的 add_header 是**子层级覆盖父层级**：这里必须把需要的头重新写一遍，
    #    只写 X-Frame-Options 而不管 CSP，frame-ancestors 'none' 仍然会挡。
    # ⚠️ 正则 location 的优先级高于普通前缀（/api/ 不是 ^~），所以这条会先生效。
    location ~ ^/api/(?:org|public|student|admin)/.*preview$ {
        proxy_pass http://127.0.0.1:8789;
        proxy_http_version 1.1;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
        proxy_buffering off;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header Content-Security-Policy "default-src 'self'; frame-ancestors 'self'; object-src 'none'; base-uri 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    }

    location = /admin { return 301 /admin/; }
    location /admin/ {
        root /srv/ai-kids-platform/production/current/apps;
        try_files $uri $uri/ /admin/index.html;
    }
    location = /org { return 301 /org/; }
    location /org/ {
        root /srv/ai-kids-platform/production/current/apps;
        try_files $uri $uri/ /org/index.html;
    }

    location / {
        root /srv/ai-kids-platform/production/current/apps/website;
        index index.html;
        try_files $uri $uri/ /index.html;
    }
}
