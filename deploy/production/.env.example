# 生产环境变量模板（不含任何真实密钥）
# 复制为 /etc/ai-kids-platform/production.env 后由运维填写；不要提交真实配置。

NODE_ENV=production
DEPLOYMENT_MODE=public
PORT=8789

# API 只监听回环地址，公网流量必须经 Nginx
API_HOST=127.0.0.1

# 独立生产数据库
PLATFORM_DATA_DIR=/srv/ai-kids-platform/production/data
PLATFORM_DB_PATH=/srv/ai-kids-platform/production/data/platform.db

PUBLIC_SITE_URL=https://iicili.cyou
ADMIN_APP_ORIGIN=https://iicili.cyou/admin
STUDENT_APP_ORIGIN=https://iicili.cyou/student
ORG_APP_ORIGIN=https://iicili.cyou/org
CORS_ALLOWED_ORIGINS=https://iicili.cyou,https://iicili.cyou/admin,https://iicili.cyou/org,https://iicili.cyou/student

# Vite 构建期变量；运行时 EnvironmentFile 不会改变已构建 JS
VITE_DEPLOYMENT_MODE=public
VITE_API_BASE=/api
VITE_PUBLIC_SITE_URL=https://iicili.cyou
VITE_ORG_APP_URL=https://iicili.cyou/org

# 正式接入真实 AI 前继续保持 local-mock，不得对外宣称真实 AI 能力
AI_PROVIDER=local-mock
AI_PROVIDER_MODEL=canvas-mock-v1
AI_PROVIDER_ENDPOINT=
