# 生产环境变量模板（不含任何真实密钥）
# 复制为 /etc/ai-kids-platform/production.env 后由运维填写；不要提交真实配置。

NODE_ENV=production
DEPLOYMENT_MODE=public
PORT=8789

# API 只监听回环地址，公网流量必须经 Nginx
API_HOST=127.0.0.1

# 独立生产数据库
PLATFORM_DATA_DIR=/srv/ai-kids-platform/production/data
PLATFORM_DB_PATH=/srv/ai-kids-platform/production/data/platform.db

# 学生运行时网关（dsh 迁移）：签发/校验「学生容器 → 平台网关」那把运行时密钥的 HMAC 密钥。
# 必须配置，否则 /api/gateway/v1/* 一律拒绝服务（故意 fail-closed：这个端点能让调用方花平台的算力钱）。
# 生成：openssl rand -base64 48
# ⚠️ 换密钥 = 所有正在上课的容器立刻失效（它们手里的密钥验不过）→ 挑没有课堂的时候换。
RUNTIME_GATEWAY_SECRET=

PUBLIC_SITE_URL=https://iicili.cyou
ADMIN_APP_ORIGIN=https://iicili.cyou/admin
ORG_APP_ORIGIN=https://iicili.cyou/org
CORS_ALLOWED_ORIGINS=https://iicili.cyou,https://iicili.cyou/admin,https://iicili.cyou/org

# Vite 构建期变量；运行时 EnvironmentFile 不会改变已构建 JS
VITE_DEPLOYMENT_MODE=public
VITE_API_BASE=/api
VITE_PUBLIC_SITE_URL=https://iicili.cyou
VITE_ORG_APP_URL=https://iicili.cyou/org

# 真实 adapter 已支持 openai-compatible / custom 的 TEXT、IMAGE、MUSIC、VIDEO、PODCAST、DUBBING；未配置前继续保持 local-mock
AI_PROVIDER=local-mock
AI_PROVIDER_MODEL=canvas-mock-v1
AI_PROVIDER_ENDPOINT=
AI_PROVIDER_TIMEOUT_MS=120000

# 文件安全上传（生产必须放在 Web 根目录之外）
FILE_UPLOAD_ROOT=/srv/ai-kids-platform/production/uploads
FILE_UPLOAD_MAX_BYTES=26214400
FILE_UPLOAD_USER_PER_HOUR=20
FILE_UPLOAD_ORG_PER_HOUR=200
FILE_UPLOAD_MAX_CONCURRENT=3
FILE_UPLOAD_USER_QUOTA_BYTES=524288000
FILE_UPLOAD_ORG_QUOTA_BYTES=5368709120
# 生产默认要求扫描器可用；安装 ClamAV 后取消注释并重启服务。
FILE_UPLOAD_REQUIRE_SCANNER=true
# FILE_UPLOAD_SCANNER=/usr/bin/clamscan
# 真实 AI provider（仅在确认供应商、预算和数据出境政策后启用；生产默认仍保持 local-mock）
# 密钥只能写入服务器受限 EnvironmentFile 或 Secret 管理器；禁止写入 Git、前端、请求参数或日志。
# AI_PROVIDER=openai-compatible
# AI_PROVIDER_MODEL=
# AI_PROVIDER_ENDPOINT=
# AI_PROVIDER_API_KEY=

# Optional JSON map for providers whose modality APIs use separate endpoints. Keys: IMAGE, MUSIC, VIDEO, PODCAST, DUBBING.
# AI_PROVIDER_MODALITY_ENDPOINTS={}
# Optional speech voice for DUBBING; defaults to alloy.
# AI_PROVIDER_VOICE=alloy
# Poll interval for async media jobs (milliseconds).
# AI_PROVIDER_POLL_INTERVAL_MS=2000

# ── 文件存储后端（2026-09-23 加）──────────────────────────────────────────────
# 缺省（不写这一段）= 全部走本地盘，行为与以前**完全一致**。
# 只有把 FILE_STORAGE 显式设成 oss 且下面几项都配齐，才会真的写 OSS
# （配置不齐时自动退回本地 —— fail-closed，见 apps/server/src/services/fileStorage.js）。
# 老数据不会因为打开开关就搬家：每一行用 metadata.storageBackend 记自己落在哪儿，
# 没有这个字段的一律当本地盘，所以**回滚就是把本段删掉/把 FILE_STORAGE 改回 local**。
# FILE_STORAGE=oss
# OSS_BUCKET=
# OSS_REGION=cn-guangzhou
# OSS_ENDPOINT=oss-cn-guangzhou.aliyuncs.com             # 给浏览器签发的 URL 用公网端点
# OSS_INTERNAL_ENDPOINT=oss-cn-guangzhou-internal.aliyuncs.com   # 服务器自己读写走内网：免流量费
# OSS_PREFIX=lingdong                                     # 可选：对象键统一前缀
# ⚠️ 下面两行是密码级的东西：只写在这个文件（权限 600、root 属主），
#    不进仓库、不进文档、不进聊天记录。
# OSS_ACCESS_KEY_ID=
# OSS_ACCESS_KEY_SECRET=
